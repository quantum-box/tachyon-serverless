# HELP tsls_build_info Gateway version (value is always 1).
# TYPE tsls_build_info gauge
tsls_build_info{version="0.1.0"} 1
# HELP tsls_environment_reuse_mode 1 for the active mode: warm_reuse (pooled environments are reused) or every_invocation_boots (no warm stage: every invocation boots its own environment).
# TYPE tsls_environment_reuse_mode gauge
tsls_environment_reuse_mode{provider="firecracker",mode="warm_reuse"} 0
tsls_environment_reuse_mode{provider="firecracker",mode="every_invocation_boots"} 1
# HELP tsls_pool_reuse_enabled 1 when the provider's idle capabilities and [pool] enabled allow environment reuse.
# TYPE tsls_pool_reuse_enabled gauge
tsls_pool_reuse_enabled 0
# HELP tsls_pool_held_environments Environments whose bridge session the pool holds (idle or being quiesced).
# TYPE tsls_pool_held_environments gauge
tsls_pool_held_environments 0
# HELP tsls_pool_quiescing_environments Environments on their way into the pool (being quiesced).
# TYPE tsls_pool_quiescing_environments gauge
tsls_pool_quiescing_environments 0
# HELP tsls_node_info The node this gateway schedules on (value is always 1).
# TYPE tsls_node_info gauge
tsls_node_info{node="lab-d8a977f8"} 1
# HELP tsls_node_reserved_cpu_millicores CPU reserved by live reservations (starting, busy, parking, idle, draining) including per-environment overhead.
# TYPE tsls_node_reserved_cpu_millicores gauge
tsls_node_reserved_cpu_millicores 0
# HELP tsls_node_reserved_memory_bytes Memory reserved by live reservations including per-environment overhead.
# TYPE tsls_node_reserved_memory_bytes gauge
tsls_node_reserved_memory_bytes 0
# HELP tsls_node_reserved_ephemeral_storage_bytes Ephemeral storage reserved by live reservations.
# TYPE tsls_node_reserved_ephemeral_storage_bytes gauge
tsls_node_reserved_ephemeral_storage_bytes 0
# HELP tsls_node_environment_overhead_memory_bytes Per-environment VMM + bridge memory overhead added to every reservation.
# TYPE tsls_node_environment_overhead_memory_bytes gauge
tsls_node_environment_overhead_memory_bytes 67108864
# HELP tsls_node_max_concurrency [capacity] max_concurrency: the cap on promised + starting + busy.
# TYPE tsls_node_max_concurrency gauge
tsls_node_max_concurrency 8
# HELP tsls_node_in_flight Promised + starting + busy reservations on the node.
# TYPE tsls_node_in_flight gauge
tsls_node_in_flight 0
