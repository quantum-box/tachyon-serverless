# case: epoch-fencing-removed
# what: a lease accepts a completion carrying a stale epoch
# gate: security:lease_epoch
# known-bad change (applied to a temporary copy only):
--- crates/domain/src/environment.rs.orig	2026-09-17 12:51:49
+++ crates/domain/src/environment.rs	2026-09-17 12:51:49
@@ -348,7 +348,7 @@
     /// A completion carrying `(attempt_id, epoch)` is only accepted if it matches
     /// this lease exactly. Prevents stale results from overwriting state.
     pub fn accepts(&self, attempt_id: &AttemptId, epoch: u64) -> bool {
-        self.released_at.is_none() && &self.attempt_id == attempt_id && self.epoch == epoch
+        self.released_at.is_none() && &self.attempt_id == attempt_id && (self.epoch == epoch || true)
     }
 }
 
