# Pinned nats-server release for the local durable queue (PLT-4638, docs/adr/0008).
#
# The checksums are copied from the release's SHA256SUMS file
# (https://github.com/nats-io/nats-server/releases/download/v2.14.7/SHA256SUMS, fetched
# 2026-09-17). scripts/queue/lib.sh refuses a download whose sha256 differs. To upgrade: change
# the version, copy the four lines from the new SHA256SUMS, run scripts/queue/verify.sh and commit
# the evidence.
NATS_SERVER_VERSION=v2.14.7
NATS_SERVER_SHA256_darwin_arm64=9fc225cddebc67438345ad988c5d6bfc6daad16a7609bcceaafa88bcab9b9001
NATS_SERVER_SHA256_darwin_amd64=c35bd7c1b84ee0b2de25f7aa0a9f1bb4834640ac8a93698a6b79f9d1de3cf5ff
NATS_SERVER_SHA256_linux_amd64=e5c20b1cb2c0566b54c544312e91e011f9e130c5c80f16a14f4cf28ef30b8be2
NATS_SERVER_SHA256_linux_arm64=50e0258a1b7290f3fe2e4f17506b74a90ffb1dd77867ae3a402eb0c9e2b0d40f
