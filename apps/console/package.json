{
  "name": "tachyon-serverless-console",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Functions console (PLT-4644): a static Next.js export that calls the public Tachyon Serverless management API with the viewer's tenant token.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "lint": "biome lint ./src ./e2e && biome format ./src ./e2e",
    "format:write": "biome format --write ./src ./e2e",
    "ts": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../docs/openapi.json -o src/gen/openapi/serverless-api.ts",
    "check:api": "node scripts/check-api-types.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.19",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-toast": "1.2.19",
    "@tachyon-sdk/native-ui": "github:quantum-box/native-ui#2d4424988f2dd1dd838951e2599d1b7498776772",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.474.0",
    "next": "14.2.35",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swr": "2.4.2",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.8.0",
    "postcss": "8.5.17",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.11 <23",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "next>react": "19",
        "next>react-dom": "19"
      }
    }
  }
}
