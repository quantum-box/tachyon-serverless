# Security regression group (PLT-4645).
#
# Every line names ONE test that must exist and pass. scripts/ci/security-regression.sh runs
# them with `cargo test -p <package> <target> -- --exact <name>...` and fails when a listed
# test did not run (renamed, removed, #[ignore]d or filtered out), so a rename cannot silently
# drop coverage. Change this file in the same PR that renames or replaces a test.
#
# Format: <category> <package> <target> <test path as printed by `cargo test -- --list`>
#   category: tenant_authz | reuse_key | lease_epoch | deadline | egress_gate | resource_limits
#   target:   lib  -> `--lib`
#             test:<name> -> `--test <name>` (tests/<name>.rs)
# Blank lines and lines starting with '#' are ignored.

# --- tenant authorization: another tenant's resources are NotFound, roles are enforced --------
tenant_authz tachyon-serverless-application lib authz::tests::foreign_tenant_is_not_found
tenant_authz tachyon-serverless-application lib authz::tests::roles
tenant_authz tachyon-serverless-application lib error::tests::tenant_mismatch_is_not_found
tenant_authz tachyon-serverless-application lib error::tests::foreign_and_missing_secret_bindings_are_indistinguishable
tenant_authz tachyon-serverless-application lib local_ports::tests::identity_and_secrets_are_tenant_scoped
tenant_authz tachyon-serverless-application lib services::invoke::tests::secret_binding_failures_do_not_reveal_other_tenants
tenant_authz tachyon-serverless-application lib config::tests::invalid_tenant_id_is_rejected
tenant_authz tachyon-serverless-application lib repository::contract_tests::memory::rows_never_cross_a_tenant
tenant_authz tachyon-serverless-application lib repository::contract_tests::sqlite::rows_never_cross_a_tenant
tenant_authz tachyon-serverless-application lib repository::contract_tests::sqlite::artifact_ownership_is_per_tenant
tenant_authz tachyon-serverless-application test:pipeline cross_tenant_resources_are_not_found
tenant_authz tachyon-serverless-application test:pipeline revisions_cannot_reference_another_tenants_artifact
tenant_authz tachyon-serverless-gateway test:gateway_integration operator_role_is_own_tenant_read_only
tenant_authz tachyon-serverless-gateway test:gateway_integration foreign_artifact_digest_is_indistinguishable_from_a_missing_one
tenant_authz tachyon-serverless-cli test:mock_gateway cross_tenant_resource_is_404_exit_2
tenant_authz tachyon-serverless-cli test:mock_gateway wrong_token_is_exit_2

